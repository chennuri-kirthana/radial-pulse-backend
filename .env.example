# Radial Pulse API — local development settings.
# Copy to .env in the repo root (git-ignored). NEVER commit real values.

APP_ENV=local
LOG_LEVEL=INFO
DEBUG=false

# Local PostgreSQL from docker compose (see /docker-compose.yml and scripts/db/init-local-db.sql).
# The API logs in as the RESTRICTED app role (row-level security applies):
DATABASE_URL=postgresql+psycopg://radial_app_local:radial_app_local_only@localhost:5432/radial_pulse
# Alembic logs in as the OWNER (only migrations use this):
MIGRATION_DATABASE_URL=postgresql+psycopg://radial:radial_local_only@localhost:5432/radial_pulse
# Tests against real PostgreSQL (make integration-test). OWNER login; the tests create
# their own restricted role to exercise row-level security. Uses a separate database.
TEST_DATABASE_URL=postgresql+psycopg://radial:radial_local_only@localhost:5432/radial_pulse_test


# Web (4200 = Nx serve, 5173 = Vite) and mobile (8081 = Expo) dev servers allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:8081

# Cognito (use the DEV user pool; values are public identifiers, not secrets).
# Without these, protected endpoints return 503 "authentication not configured" — there is no bypass.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
# USER app clients only (web, mobile): public, Managed Login + PKCE. Comma-separated.
COGNITO_APP_CLIENT_IDS=
COGNITO_DOMAIN=
# Zero-NAT Lambda only: read the pool's public keys from a copy in S3 (kept fresh by the
# rp-central-jwks-sync-dev Lambda, infra/cloudformation/central-jwks-sync-dev.yaml). Empty = read
# them from Cognito directly (needs internet). Never set locally.
COGNITO_JWKS_S3_URI=
# Invites: "log" changes nothing (local); "cognito" creates Cognito users (needs AWS credentials
# allowed to call cognito-idp:AdminCreateUser etc. — docs/infrastructure/manual-aws-setup.md).
IDENTITY_DIRECTORY_BACKEND=log

# Backend SERVICES on /api/v1/internal use AWS IAM (SigV4), not Cognito (app/core/iam_caller.py).
# Allowed IAM roles, copied exactly from IAM (with any path), and the scopes each one holds:
#   {"arn:aws:iam::<account>:role/<name>": {"name": "seo-agent", "scopes": ["clinics.read"]}}
INTERNAL_SERVICE_ROLES=
# Id of the separate REST API (AWS_IAM) that serves /api/v1/internal.
INTERNAL_API_ID=
# true ONLY on the Lambda function (behind the AWS Lambda Web Adapter). Keep false locally:
# /api/v1/internal then answers 503 (never open).
INTERNAL_TRUST_LAMBDA_CONTEXT=false

# S3 (DEV bucket). Credentials come from your AWS profile / SSO session, never from this file.
AWS_REGION=ap-south-1
S3_ASSETS_BUCKET=


# Connected accounts (OAuth). Frontend callback addresses allowed after "Connect" (comma-separated,
# exact match). Web dev server + the mobile app's local scheme. NOT the Cognito sign-in callback.
OAUTH_REDIRECT_URIS=http://localhost:4200/connect/callback,radialpulse-local://connect/callback
# Each platform's app credentials. Leave empty = that platform shows "not set up yet".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Tokens are stored in AWS Secrets Manager (your AWS profile locally). Optional KMS key:
CONNECTION_SECRETS_KMS_KEY_ID=
